    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
