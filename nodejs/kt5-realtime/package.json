{
  "name": "kt05-blog-api-realtime",
  "version": "1.0.0",
  "description": "Блог API из КТ4 + realtime-чат на Socket.io с JWT и комнатами",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:up": "docker compose up -d db",
