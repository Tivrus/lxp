{
  "name": "kt03-blog-api",
  "version": "1.0.0",
  "description": "REST API блог-платформы на Express + Prisma + PostgreSQL",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "joi": "^18.3.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
